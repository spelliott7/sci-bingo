generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PLAYER
  ADMIN
}

enum GameType {
  BINGO
  PICK3
}

enum GameStatus {
  DRAFT
  ACTIVE
  COMPLETED
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  email        String   @unique
  passwordHash String
  role         Role     @default(PLAYER)
  createdAt    DateTime @default(now())

  cards       BingoCard[]
  pick3Entries Pick3Entry[]
  payments    Payment[]
}

model Song {
  id        Int     @id @default(autoincrement())
  sourceId  Int?    @unique
  name      String
  isCover   Boolean @default(false)
  playCount Int     @default(0)

  squares    CardSquare[]
  played     PlayedSong[]
  pick3Picks Pick3Pick[]

  @@index([name])
}

/// A single real-world show (date/venue). Shows are shared across games —
/// marking a song played here updates every game (Bingo or Pick 3) that
/// includes this show, so the admin only ever logs a setlist once.
model Show {
  id        String   @id @default(cuid())
  name      String?
  venue     String?
  showDate  DateTime
  createdAt DateTime @default(now())

  playedSongs PlayedSong[]
  games       GameShow[]
}

model PlayedSong {
  id       String   @id @default(cuid())
  showId   String
  songId   Int
  playedAt DateTime @default(now())

  show Show @relation(fields: [showId], references: [id], onDelete: Cascade)
  song Song @relation(fields: [songId], references: [id])

  @@unique([showId, songId])
}

/// One game — either a Bingo run or a Pick 3 game — spanning one or more
/// shared Shows. Stays open across every show it includes until the admin
/// manually completes it and (optionally) declares a winner.
model Game {
  id          String     @id @default(cuid())
  type        GameType
  name        String
  status      GameStatus @default(DRAFT)
  entryFee    Decimal    @default(10.00) @db.Decimal(10, 2)
  venmoHandle String?
  createdAt   DateTime   @default(now())
  completedAt DateTime?

  shows    GameShow[]
  cards    BingoCard[]  @relation("GameCards")
  entries  Pick3Entry[] @relation("GameEntries")
  payments Payment[]

  winnerCardId String?     @unique
  winnerCard   BingoCard?  @relation("GameBingoWinner", fields: [winnerCardId], references: [id])
  winnerEntryId String?    @unique
  winnerEntry  Pick3Entry? @relation("GamePick3Winner", fields: [winnerEntryId], references: [id])
}

model GameShow {
  gameId String
  showId String

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)
  show Show @relation(fields: [showId], references: [id], onDelete: Cascade)

  @@id([gameId, showId])
}

model BingoCard {
  id         String   @id @default(cuid())
  gameId     String
  userId     String
  playerName String
  createdAt  DateTime @default(now())

  game    Game         @relation("GameCards", fields: [gameId], references: [id], onDelete: Cascade)
  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  squares CardSquare[]
  wonGame Game?        @relation("GameBingoWinner")

  @@unique([gameId, userId])
}

model CardSquare {
  id       String @id @default(cuid())
  cardId   String
  position Int
  songId   Int?

  card BingoCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  song Song?     @relation(fields: [songId], references: [id])

  @@unique([cardId, position])
}

model Pick3Entry {
  id         String   @id @default(cuid())
  gameId     String
  userId     String
  playerName String
  createdAt  DateTime @default(now())

  game    Game        @relation("GameEntries", fields: [gameId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  picks   Pick3Pick[]
  wonGame Game?       @relation("GamePick3Winner")

  @@unique([gameId, userId])
}

model Pick3Pick {
  id      String @id @default(cuid())
  entryId String
  songId  Int

  entry Pick3Entry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  song  Song       @relation(fields: [songId], references: [id])

  @@unique([entryId, songId])
}

model Payment {
  id        String    @id @default(cuid())
  gameId    String
  userId    String
  amountDue Decimal   @default(10.00) @db.Decimal(10, 2)
  paid      Boolean   @default(false)
  paidAt    DateTime?
  note      String?

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([gameId, userId])
}
