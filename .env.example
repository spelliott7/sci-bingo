# Postgres connection string.
# For local dev with the provided docker-compose.yml, this matches out of the box.
DATABASE_URL="postgresql://sci_bingo:sci_bingo@localhost:5432/sci_bingo?schema=public"

# Long random string used to sign session cookies (site gate + user/admin login).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="replace-with-a-long-random-string"

# The single shared keyword + password everyone uses at the /gate page before
# they can register, log in, or see anything else on the site.
GATE_KEYWORD="cheese"
GATE_PASSWORD="incident"

# Optional: if both are set, `npm run prisma:seed` will create/update this
# account as an ADMIN so you have a way into /admin on a fresh database.
ADMIN_SEED_USERNAME="admin"
ADMIN_SEED_PASSWORD="change-me-immediately"
